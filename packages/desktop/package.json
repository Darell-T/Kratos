{
  "name": "@kratos/desktop",
  "productName": "Kratos",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist/main.js",
    "dev": "npm run build && electron . --dev-url=http://localhost:5173",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "esbuild": "^0.28.2"
  }
}
