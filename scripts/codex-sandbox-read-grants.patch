+use std::sync::mpsc;
+use std::thread;
+use std::time::Duration;
 use windows_sys::Win32::Foundation::HLOCAL;
 use windows_sys::Win32::Foundation::LocalFree;

+#[test]
+fn read_acl_requests_wait_for_the_previous_owner() {
+    let owner = acquire_read_acl_mutex().expect("first request owns read grants");
+    let (starting, started) = mpsc::channel();
+    let (completed, completion) = mpsc::channel();
+    let waiter = thread::spawn(move || {
+        starting.send(()).expect("report request start");
+        let _guard = acquire_read_acl_mutex().expect("waiting request owns read grants");
+        completed.send(()).expect("report request completion");
+    });
+    started
+        .recv_timeout(Duration::from_secs(5))
+        .expect("waiting request started");
+    let finished_while_owned = completion.recv_timeout(Duration::from_millis(250)).is_ok();
+    drop(owner);
+    if !finished_while_owned {
+        completion
+            .recv_timeout(Duration::from_secs(5))
+            .expect("waiting request completes after its predecessor");
+    }
+    waiter.join().expect("waiting request finishes");
+    assert!(
+        !finished_while_owned,
+        "the second request skipped the active grant"
+    );
+}
